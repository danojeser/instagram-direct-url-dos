{
  "name": "instagram-url-direct",
  "version": "2.1.0",
  "description": "Get direct url to download from Instagram media links",
  "type": "module",
  "main": "dist/instagram.js",
  "types": "dist/types/instagram.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/instagram.d.ts",
      "import": "./dist/instagram.js",
      "require": "./dist/instagram.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "postbuild": "rollup ./dist/instagram.js --format cjs --exports named --file ./dist/instagram.cjs --external axios,qs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danojeser/instagram-direct-url-dos.git"
  },
  "keywords": [
    "instagram",
    "downloader",
    "media",
    "link",
    "photo",
    "video",
    "url",
    "picture",
    "image",
    "download"
  ],
  "author": "victorsouzaleal <victorsouzaleal@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danojeser/instagram-direct-url-dos/issues"
  },
  "homepage": "https://github.com/danojeser/instagram-direct-url-dos#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qs": "^6.15.1",
    "rollup": "^4.63.5",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.9.3"
  },
  "contributors": [
    "Daniel Ojeda <danojeser@gmail.com>"
  ]
}
